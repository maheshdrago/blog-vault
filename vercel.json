{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://blog-vault-api.onrender.com/api/:path*"
    },
    {
      "source": "/((?!api/|assets/|content/).*)",
      "destination": "/index.html"
    }
  ]
}
