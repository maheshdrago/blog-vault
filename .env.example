# Blog Vault local environment
# Copy to .env and replace the required values. Never commit .env.

# -----------------------------------------------------------------------------
# Required: Supabase PostgreSQL
# -----------------------------------------------------------------------------
# Dashboard -> Connect -> Session pooler (port 5432).
# Keep the +asyncpg prefix and URL-encode special characters in the password.
BLOG_DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# -----------------------------------------------------------------------------
# Required: Supabase Auth
# -----------------------------------------------------------------------------
# Dashboard -> Connect or Settings -> API.
BLOG_SUPABASE_URL=https://PROJECT_REF.supabase.co
BLOG_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# The following values are derived automatically:
# - JWT issuer: BLOG_SUPABASE_URL + /auth/v1
# - MCP OAuth issuer: the JWT issuer
# - JWT and MCP audience: authenticated
# - Local auth callback: http://localhost:5173/api/v1/auth/callback
# - Local MCP resource: http://localhost:8000/mcp/
# - Local browser origins: http://localhost:5173

# -----------------------------------------------------------------------------
# Optional: Langfuse tracing
# -----------------------------------------------------------------------------
# Tracing is disabled unless both keys are present.
BLOG_LANGFUSE_PUBLIC_KEY=pk-lf-REPLACE_ME
BLOG_LANGFUSE_SECRET_KEY=sk-lf-REPLACE_ME
BLOG_LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
BLOG_LANGFUSE_ENVIRONMENT=development
BLOG_LANGFUSE_SAMPLE_RATE=1.0

# -----------------------------------------------------------------------------
# Optional: privacy-conscious device/network fingerprinting
# -----------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
# BLOG_IP_HMAC_SECRET=REPLACE_WITH_64_HEX_CHARACTERS

# -----------------------------------------------------------------------------
# Production-only overrides
# Configure these in Render/Vercel dashboards, not in the local .env.
# -----------------------------------------------------------------------------

# Render:
# BLOG_ALLOWED_ORIGINS=["https://YOUR_PROJECT.vercel.app"]
# BLOG_AUTH_ALLOWED_ORIGINS=["https://YOUR_PROJECT.vercel.app"]
# BLOG_AUTH_COOKIE_SECURE=true
# BLOG_AUTH_CALLBACK_URL=https://YOUR_PROJECT.vercel.app/api/v1/auth/callback
# BLOG_MCP_RESOURCE_URL=https://YOUR_RENDER_SERVICE.onrender.com/mcp/
# BLOG_IP_HMAC_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
# BLOG_LANGFUSE_ENVIRONMENT=production

# Vercel:
# VITE_MCP_URL=https://YOUR_RENDER_SERVICE.onrender.com/mcp/
#
# VITE_API_URL does not need to be set. It defaults to /api/v1, which Vite
# proxies locally and Vercel rewrites to Render in production.
