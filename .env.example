# Copy this file to .env for local development. Never commit .env.

# -----------------------------------------------------------------------------
# Frontend (safe to expose in the browser)
# -----------------------------------------------------------------------------
# Local FastAPI URL. In Vercel, replace this with the Render service URL.
VITE_API_URL=http://localhost:8000/api/v1

# -----------------------------------------------------------------------------
# FastAPI
# -----------------------------------------------------------------------------
# Must be a JSON array. Add the production Vercel domain when deploying.
BLOG_ALLOWED_ORIGINS=["http://localhost:5173"]

# -----------------------------------------------------------------------------
# Supabase PostgreSQL
# -----------------------------------------------------------------------------
# Supabase Dashboard -> Connect -> Session pooler (port 5432).
# Keep the +asyncpg driver prefix. URL-encode special characters in the password.
BLOG_DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# -----------------------------------------------------------------------------
# Human article review
# -----------------------------------------------------------------------------
# Must be different from the MCP token. It protects review and publish routes.
BLOG_ADMIN_ACCESS_TOKEN=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET

# -----------------------------------------------------------------------------
# Private MCP endpoint
# -----------------------------------------------------------------------------
# Generate a long random value, for example: openssl rand -hex 32
# MCP clients send it as: Authorization: Bearer <token>
BLOG_MCP_ACCESS_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET

# -----------------------------------------------------------------------------
# Langfuse tracing (optional; disabled unless both keys are present)
# -----------------------------------------------------------------------------
# Project Settings -> API Keys. Match the URL to the project's data region.
BLOG_LANGFUSE_PUBLIC_KEY=pk-lf-REPLACE_ME
BLOG_LANGFUSE_SECRET_KEY=sk-lf-REPLACE_ME
BLOG_LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
BLOG_LANGFUSE_ENVIRONMENT=development
# Trace everything initially; lower this for high-volume read traffic.
BLOG_LANGFUSE_SAMPLE_RATE=1.0
